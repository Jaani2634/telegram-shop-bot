# Copy karke .env banao: cp .env.example .env
# BOT_TOKEN: @BotFather se /newbot karke milega - chat me kabhi mat bhejo
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# ADMIN_ID: @userinfobot se verified 2026-11-11 (Junaid, Jaani Sb)
ADMIN_ID=7965730503
# Payment details - ye bot ke /admin > /setpayments se bhi change ho jayenge
JAZZCASH_NUMBER=03001234567
JAZZCASH_NAME=Junaid
EASYPAISA_NUMBER=+923706462990
EASYPAISA_NAME=Junaid Nazeer
USDT_ADDRESS=TXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DB_PATH=shop.db
# Zurvapay auto-verify (JazzCash / Easypaisa / Raast QR) — dashboard se keys milne ke baad bharo
# Khaali ho to Zurvapay option dikhega hi nahi; manual + USDT flows waisi hi chalengi.
ZURVAPAY_PUBLIC_KEY=
ZURVAPAY_SECRET_KEY=
# Bot ki public URL (Botkeep/Render host) — IPN + success/cancel URLs isi se bante hain
PUBLIC_BASE_URL=
# Optional: ZURVAPAY_IPN_URL=https://<host>:<port>/zurvapay/ipn
# Optional: ZURVAPAY_BASE_URL=https://zurvapay.com
# Optional: ZURVAPAY_IPN_MODE=auto
# Optional: ZURVAPAY_BOT_ID=Shop_at_Retail_bot  # default BOT_USERNAME; initiate me lazmi bheja jata hai
# Channels (optional — khaali ho to koi gate nahi lagta)
# TG_CHANNEL: Telegram channel ka username, jaise @RetailShopChannel — bot ko is me ADMIN banana zaroori hai
TG_CHANNEL=
# TG_GROUP_URL: Telegram group ka invite link, jaise https://t.me/+xxxx
TG_GROUP_URL=
# WA_CHANNEL_URL: WhatsApp channel ka link, jaise https://whatsapp.com/channel/xxxx
WA_CHANNEL_URL=
